# ---------------------------------------------------------------------------
# Project Camp — backend environment
# Copy this file to `.env` and fill in the values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Port the API listens on. Defaults to 3000 if unset, but the frontend dev
# proxy (frontend/vite.config.js) is hard-coded to http://localhost:8000 —
# keep this at 8000 unless you change the proxy target too.
PORT=8000

# Set to "production" in a deployed environment. This turns on the `secure`
# flag for the auth cookies, which requires HTTPS. Leave unset in local dev.
NODE_ENV=development

# --- Database -------------------------------------------------------------
# MongoDB connection string (local or Atlas).
# Local example:  mongodb://127.0.0.1:27017/projectcamp
MONGO_URI=

# --- CORS / frontend origin ----------------------------------------------
# Comma-separated list of allowed browser origins.
# The FIRST entry is also used as the base URL for the links embedded in
# verification and password-reset emails, so it must point at the frontend.
CORS_ORIGIN=http://localhost:5173

# --- JWT ------------------------------------------------------------------
# Use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# --- SMTP (email verification + password reset) ---------------------------
# Any SMTP provider works; the variable names reference Mailtrap because that
# is what the project was developed against.
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
