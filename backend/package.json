{
  "name": "projectmanagement",
  "version": "1.0.0",
  "description": "a project management application for learning",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec \"node --env-file=.env src/index.js\"",
    "start": "node --env-file=.env src/index.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "lint": "prettier --check src/ scripts/ tests/",
    "format": "prettier --write src/ scripts/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samarththakuri/Project-management.git"
  },
  "keywords": [
    "course",
    "learning",
    "backend",
    "api",
    "creation"
  ],
  "author": "samarth",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Samarththakuri/Project-management/issues"
  },
  "homepage": "https://github.com/Samarththakuri/Project-management#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mailgen": "^2.0.36",
    "mongoose": "^8.19.1",
    "morgan": "^1.12.0",
    "nodemailer": "^9.0.6",
    "prom-client": "^15.1.3",
    "zod": "^4.5.4"
  }
}
