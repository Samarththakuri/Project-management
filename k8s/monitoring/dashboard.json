{
  "title": "Project Camp - Golden Signals",
  "uid": "projectcamp-golden",
  "tags": ["projectcamp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(kube_pod_info{namespace=~\"projectcamp-.*\"}, namespace)",
        "refresh": 1,
        "includeAll": false,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Golden signals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Traffic - requests/sec by route",
      "description": "rate(http_requests_total). Exposed by the backend via prom-client. Routes are Express route patterns, not resolved URLs, so cardinality stays bounded.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors - 5xx rate as % of all requests",
      "description": "A server-error ratio, not a raw count: 10 errors/sec matters very differently at 20 rps than at 2000 rps.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{namespace=\"$namespace\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\"}[5m])), 0.001)",
          "legendFormat": "5xx %",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(http_requests_total{namespace=\"$namespace\",status_code=~\"4..\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\"}[5m])), 0.001)",
          "legendFormat": "4xx %",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency - p50 / p95 / p99",
      "description": "Quantiles from http_request_duration_seconds_bucket. p99 is the one that reflects what the unluckiest users experience.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by route",
      "description": "Which endpoint is slow, rather than just that something is.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Saturation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "timeseries",
      "title": "CPU usage vs request",
      "description": "From cAdvisor. The dashed request line is what the HPA scales against - it targets 70% of the request, not the limit.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"$namespace\",resource=\"cpu\"})",
          "legendFormat": "total requested",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory working set vs limit",
      "description": "Memory is the limit that actually kills: exceeding it is an OOMKill, not throttling. Watch for a pod tracking steadily toward its limit.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "min(kube_pod_container_resource_limits{namespace=\"$namespace\",resource=\"memory\",container=\"backend\"})",
          "legendFormat": "backend limit",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Deployment health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries",
      "title": "Replicas: desired vs available",
      "description": "During a healthy rolling update available never drops below desired, because maxUnavailable is 0. A gap here means the rollout is stalling.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\"}",
          "legendFormat": "{{deployment}} desired",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\"}",
          "legendFormat": "{{deployment}} available",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container restarts (1h)",
      "description": "A rising line is CrashLoopBackOff. Cross-reference with the readiness probe: restarts with healthy readiness usually mean an OOMKill.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h])",
          "legendFormat": "{{pod}}/{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pods ready",
      "description": "Pods passing their readiness probe. These, and only these, are in the ALB target group.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"$namespace\",condition=\"true\"})",
          "legendFormat": "ready",
          "refId": "A"
        }
      ]
    }
  ]
}
